{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "install-requirements",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pip",
				"install",
				"-r",
				"${workspaceFolder}/requirements.txt"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "run-smoke-all",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"experiments.runner",
				"--smoke"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "run-paper-all",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"experiments.runner",
				"--paper"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "validate-result-contract",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"experiments.runner",
				"--validate-contract"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "rerun-and-validate-smoke",
			"type": "shell",
			"command": "python",
			"args": [
				"scripts/rerun_and_validate_contract.py",
				"--smoke"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "generate-paper-figures",
			"type": "shell",
			"command": "python",
			"args": [
				"docs/figure_scripts/generate_all.py"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "archive-and-clear-results",
			"type": "shell",
			"command": "python",
			"args": [
				"scripts/archive_and_clear.py"
			],
			"group": "build",
			"problemMatcher": []
		}
	]
}
